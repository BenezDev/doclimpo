{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "Content-Security-Policy-Report-Only": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://*.supabase.co https://viacep.com.br; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'",
        "X-Frame-Options": "DENY",
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
        "Permissions-Policy": "geolocation=(), camera=(), microphone=(), payment=()"
      },
      "continue": true
    },
    {
      "src": "/sw.js",
      "headers": {
        "Cache-Control": "no-cache"
      },
      "continue": true
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/cadastro/?",
      "dest": "/cadastro/index.html"
    },
    {
      "src": "/login/?",
      "dest": "/login/index.html"
    },
    {
      "src": "/obrigado/?",
      "dest": "/obrigado/index.html"
    },
    {
      "src": "/privacidade/?",
      "dest": "/privacidade/index.html"
    },
    {
      "src": "/termos/?",
      "dest": "/termos/index.html"
    },
    {
      "src": "/redefinir-senha/?",
      "dest": "/redefinir-senha/index.html"
    },
    {
      "src": "/onboarding/?",
      "dest": "/onboarding/index.html"
    },
    {
      "src": "/dashboard/?",
      "dest": "/dashboard/index.html"
    },
    {
      "src": "/conta/?",
      "dest": "/conta/index.html"
    },
    {
      "src": "/documento/[^/]+/?",
      "dest": "/documento/index.html"
    },
    {
      "src": "/documentos/?",
      "dest": "/documentos/index.html"
    },
    {
      "src": "/documentos/cnh/?",
      "dest": "/documentos/cnh/index.html"
    },
    {
      "src": "/documentos/crlv/?",
      "dest": "/documentos/crlv/index.html"
    },
    {
      "src": "/documentos/ipva/?",
      "dest": "/documentos/ipva/index.html"
    },
    {
      "src": "/documentos/passaporte/?",
      "dest": "/documentos/passaporte/index.html"
    },
    {
      "src": "/documentos/rg/?",
      "dest": "/documentos/rg/index.html"
    },
    {
      "src": "/documentos/seguro/?",
      "dest": "/documentos/seguro/index.html"
    },
    {
      "src": "/documentos/plano_saude/?",
      "status": 301,
      "headers": {
        "Location": "/documentos/plano-de-saude"
      }
    },
    {
      "src": "/documentos/plano-de-saude/?",
      "dest": "/documentos/plano-de-saude/index.html"
    },
    {
      "src": "/documentos/carteira_trabalho/?",
      "status": 301,
      "headers": {
        "Location": "/documentos/carteira-de-trabalho"
      }
    },
    {
      "src": "/documentos/carteira-de-trabalho/?",
      "dest": "/documentos/carteira-de-trabalho/index.html"
    },
    {
      "src": "/documentos/garantia/?",
      "dest": "/documentos/garantia/index.html"
    },
    {
      "src": "/documentos/contrato/?",
      "dest": "/documentos/contrato/index.html"
    },
    {
      "src": "/documentos/exame/?",
      "dest": "/documentos/exame/index.html"
    },
    {
      "src": "/documentos/multa/?",
      "dest": "/documentos/multa/index.html"
    },
    {
      "src": "/sobre/?",
      "dest": "/sobre/index.html"
    },
    {
      "src": "/seguranca/?",
      "dest": "/seguranca/index.html"
    },
    {
      "src": "/404(?:\\.html)?/?",
      "dest": "/404.html",
      "status": 404
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/404.html",
      "status": 404
    }
  ]
}
