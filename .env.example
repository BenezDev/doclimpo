# --- Frontend (Vite) ---
# Estas duas são embutidas no bundle e são públicas por design.
# O que protege os dados é o RLS, não o segredo destas chaves.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Chave pública VAPID (base64url) para notificações push; a privada fica só na Edge Function.
VITE_VAPID_PUBLIC_KEY=

# --- Edge Functions (definir no painel do Supabase, NUNCA aqui) ---
# SUPABASE_SERVICE_ROLE_KEY   já vem injetada pelo Supabase
# CRON_SECRET                 segredo compartilhado com o pg_cron; protege
#                             check-expiring-documents e send-pending-notifications
# RESEND_API_KEY              envio de email
# EMAIL_FROM                  ex: "DocLimpo <alertas@seudominio.com.br>"
# APP_URL                     ex: https://www.doclimpo.com
# CAKTO_CLIENT_ID             chave da API Cakto (painel Cakto > Integrações > Cakto API), escopos
# CAKTO_CLIENT_SECRET         read, write, subscriptions — cancelamento e leitura de assinaturas
# CAKTO_WEBHOOK_SECRET        segredo do webhook (HMAC de X-Cakto-Signature) apontado para
#                             https://<ref>.supabase.co/functions/v1/cakto-webhook
# CAKTO_OFFER_INDIVIDUAL      id da oferta mensal R$ 9,90 (o de pay.cakto.com.br/<id>)
# CAKTO_OFFER_FAMILIAR        id da oferta mensal R$ 29,89 (o cliente nunca escolhe a oferta)
# CAKTO_OFFER_MEI             id da oferta mensal R$ 19,89
#                             Produtos, ofertas e webhook: node scripts/cakto-provisionar.mjs
# ADMIN_EMAIL                 opcional; recebe um resumo quando alertas falham no envio
# VAPID_PUBLIC_KEY            JWK (JSON) da chave pública VAPID — Web Push
# VAPID_PRIVATE_KEY           JWK (JSON) da chave privada VAPID — nunca no repo
# VAPID_SUBJECT               mailto:contato@seudominio.com.br (contato para os serviços de push)
# WHATSAPP_TOKEN              token permanente do System User (Meta) com whatsapp_business_messaging
# WHATSAPP_PHONE_NUMBER_ID    Phone number ID do número no app da Meta
# WHATSAPP_TEMPLATE_ALERTA    nome do template Utility aprovado (4 parâmetros: nome, documento, prazo, data)
# WHATSAPP_TEMPLATE_CODIGO    nome do template Authentication aprovado (código de 6 dígitos)
# WHATSAPP_TEMPLATE_LANG      pt_BR
#
# --- Painel do Supabase > Authentication > URL Configuration ---
# Site URL:      o mesmo valor de APP_URL
# Redirect URLs: <APP_URL>/redefinir-senha   (link de recuperação de senha)
